# Copy this file to .env.local for local development; see
# docs/LOCAL-DEVELOPMENT.md. These defaults run the site and the Payload admin
# with SQLite, local media and static public content. Never copy production
# values into .env.local.

# Contact form: Formspree form ID. Left empty, the form shows a configuration
# message instead of sending.
NEXT_PUBLIC_FORMSPREE_CONTACT_FORM_ID=

# Public content sources: "static" (default) or "payload". A production build
# with any "payload" source requires PAYLOAD_DATABASE=postgres,
# PAYLOAD_STORAGE=vercel-blob, DATABASE_URL, PAYLOAD_SECRET and
# BLOB_READ_WRITE_TOKEN, and fails closed otherwise.
ARTICLE_PUBLIC_SOURCE=static
BOOK_PUBLIC_SOURCE=static
PAGE_PUBLIC_SOURCE=static
NAVIGATION_PUBLIC_SOURCE=static
PHOTO_PUBLIC_SOURCE=static

# Payload persistence. Local: SQLite and files under public/media.
# Production: PAYLOAD_DATABASE=postgres (Neon) and PAYLOAD_STORAGE=vercel-blob.
PAYLOAD_DATABASE=sqlite
PAYLOAD_STORAGE=local
DATABASE_URL=file:./.data/payload.db

# Required for /admin. Generate a local-only value with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Only used with PAYLOAD_STORAGE=vercel-blob; leave empty locally.
BLOB_READ_WRITE_TOKEN=

# Optional controls for the local e2e scripts (npm run e2e:*, check-postgres).
# Those scripts do not read .env.local: export the variable in the shell for
# a single run.
# BROWSER_CHANNEL=
# BROWSER_PACKAGE=
# DISTRICT_CMS_TEST_URL=
# DISTRICT_EXPECT_EDITORIAL=
# DISTRICT_SOURCE_MODE=
# DISTRICT_TEST_OUTPUT=
# DISTRICT_TEST_URL=
# PGLITE_MODULE=

# -----------------------------------------------------------------------------
# NEVER SET THESE LOCALLY
# Production approval gates. They are set only for one approved production
# operation, following docs/PROJECT-STATE.md section K: never in .env.local,
# never in a shell profile and never committed. Names only.
# -----------------------------------------------------------------------------

# Production migration (scripts/vercel-build.mjs, PROJECT-STATE K.2). All three
# are bound to one commit SHA and one exact list of pending migrations; set
# them in the Vercel Production environment and remove them right after the
# deployment.
# PRODUCTION_MIGRATION_APPROVED_SHA
# PRODUCTION_MIGRATION_APPROVED_NAMES
# PRODUCTION_MIGRATION_PITR_CONFIRMED_SHA

# Historical photo imports (scripts/photos/import-historical-district-batch*.ts,
# PROJECT-STATE L.1). Every approval is the deployed commit SHA: the dry-run
# approval, the import approval and the PITR confirmation (set only after PITR
# was verified for that commit).
# PRODUCTION_HISTORICAL_PHOTO_BATCH1_DRY_RUN_APPROVED_SHA
# PRODUCTION_HISTORICAL_PHOTO_BATCH1_IMPORT_APPROVED_SHA
# PRODUCTION_HISTORICAL_PHOTO_BATCH1_PITR_CONFIRMED_SHA
# PRODUCTION_HISTORICAL_PHOTO_BATCH2_DRY_RUN_APPROVED_SHA
# PRODUCTION_HISTORICAL_PHOTO_BATCH2_IMPORT_APPROVED_SHA
# PRODUCTION_HISTORICAL_PHOTO_BATCH2_PITR_CONFIRMED_SHA
# Retired: the importers refuse to run in any mode while the boolean
# PRODUCTION_HISTORICAL_PHOTO_BATCH{1,2}_IMPORT_APPROVED or
# PRODUCTION_HISTORICAL_PHOTO_BATCH{1,2}_PITR_CONFIRMED is still set.

# Retired: the build ignores PRODUCTION_MIGRATION_APPROVED and
# PRODUCTION_PITR_CONFIRMED and stops when PRODUCTION_DISTRICT_DRY_RUN_APPROVED_SHA
# is set. Remove them wherever they are still set. The gates of the archived
# district importers are described in scripts/districts/archive/README.md.
