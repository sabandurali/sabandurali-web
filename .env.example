NEXT_PUBLIC_FORMSPREE_CONTACT_FORM_ID=

# Public sources remain static by default. Production "payload" selection
# requires PAYLOAD_DATABASE=postgres, PAYLOAD_STORAGE=vercel-blob and all
# server-side secrets below.
ARTICLE_PUBLIC_SOURCE=

BOOK_PUBLIC_SOURCE=

PAGE_PUBLIC_SOURCE=

NAVIGATION_PUBLIC_SOURCE=

PHOTO_PUBLIC_SOURCE=

# Local defaults: SQLite database and files under public/media.
# Production values: PAYLOAD_DATABASE=postgres and
# PAYLOAD_STORAGE=vercel-blob.
PAYLOAD_DATABASE=
PAYLOAD_STORAGE=

PAYLOAD_SECRET=
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Optional import/test controls; leave unset for ordinary restore.
# Production approval controls must never be enabled during backup/verification.
