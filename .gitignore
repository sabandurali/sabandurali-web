# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Payload local persistence
/.data/*
!/.data/.gitkeep
/public/media/*
!/public/media/.gitkeep

# Private backup sets and local audit evidence (never publish)
/.private-backups/
/ml-env/
/reports/production-release-20261018/
*.key
*.p12
*.pfx
*.sql
*.dump
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm

# Dated private notes (backups, restores, security reviews) belong in
# /.private-backups/, never in docs/: the repository is public.
/docs/*BACKUP*-20*.md
/docs/*SECURITY-REVIEW*-20*.md
/docs/LIVE-BACKUP-*.md

# Claude Code agent worktrees and local state
/.claude/worktrees/
/.claude/settings.local.json
